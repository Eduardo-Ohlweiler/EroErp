<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="106-create-crm-atendimento-assuncao" author="eduardo">

        <createTable tableName="crm_atendimento_assuncao">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="atendimento_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_anterior_id" type="BIGINT"/>
            <column name="motivo" type="TEXT"/>
            <column name="data" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="crm_atendimento_assuncao" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_crm_assuncao_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="crm_atendimento_assuncao" baseColumnNames="atendimento_id"
                referencedTableName="crm_atendimento" referencedColumnNames="id"
                constraintName="fk_crm_assuncao_atendimento"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="crm_atendimento_assuncao" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_crm_assuncao_usuario"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="crm_atendimento_assuncao" baseColumnNames="usuario_anterior_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_crm_assuncao_usuario_ant"
                onDelete="SET NULL"/>

        <createIndex tableName="crm_atendimento_assuncao" indexName="idx_crm_assuncao_atendimento">
            <column name="atendimento_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
