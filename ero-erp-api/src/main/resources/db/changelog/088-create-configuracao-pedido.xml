<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="088-create-configuracao-pedido" author="eduardo">

        <createTable tableName="configuracao_pedido">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="faturar_ao_concluir" type="VARCHAR(10)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="configuracao_pedido" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_configuracao_pedido_cliente"
                onDelete="RESTRICT"/>

        <createIndex tableName="configuracao_pedido" indexName="idx_configuracao_pedido_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
