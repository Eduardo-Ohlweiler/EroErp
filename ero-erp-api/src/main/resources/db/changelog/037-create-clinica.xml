<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="037-create-clinica" author="eduardo">

        <!-- ── CONSULTA ───────────────────────────────────────────────────── -->
        <createTable tableName="consulta">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="compromisso_id" type="BIGINT"/>

            <column name="emitente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- AGENDADA | EM_ATENDIMENTO | CONCLUIDA | CANCELADA -->
            <column name="status" type="VARCHAR(30)" defaultValue="AGENDADA">
                <constraints nullable="false"/>
            </column>

            <column name="observacao" type="TEXT"/>

            <column name="motivo_cancelamento" type="VARCHAR(500)"/>

            <column name="consulta_pai_id" type="BIGINT"/>

            <column name="inicio" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="fim" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="consulta" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_consulta_cliente"/>

        <addForeignKeyConstraint
                baseTableName="consulta" baseColumnNames="compromisso_id"
                referencedTableName="compromisso" referencedColumnNames="id"
                constraintName="fk_consulta_compromisso"/>

        <addForeignKeyConstraint
                baseTableName="consulta" baseColumnNames="emitente_id"
                referencedTableName="emitente" referencedColumnNames="id"
                constraintName="fk_consulta_emitente"/>

        <addForeignKeyConstraint
                baseTableName="consulta" baseColumnNames="pessoa_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_consulta_pessoa"/>

        <addForeignKeyConstraint
                baseTableName="consulta" baseColumnNames="consulta_pai_id"
                referencedTableName="consulta" referencedColumnNames="id"
                constraintName="fk_consulta_pai"/>

        <createIndex tableName="consulta" indexName="idx_consulta_cliente">
            <column name="cliente_id"/>
        </createIndex>

        <createIndex tableName="consulta" indexName="idx_consulta_pessoa">
            <column name="pessoa_id"/>
        </createIndex>

        <createIndex tableName="consulta" indexName="idx_consulta_emitente">
            <column name="emitente_id"/>
        </createIndex>

        <!-- ── CONSULTA_SERVICO ───────────────────────────────────────────── -->
        <createTable tableName="consulta_servico">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="consulta_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="produto_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="quantidade" type="NUMERIC(10,3)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="preco_unitario" type="NUMERIC(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="consulta_servico" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_consulta_servico_cliente"/>

        <addForeignKeyConstraint
                baseTableName="consulta_servico" baseColumnNames="consulta_id"
                referencedTableName="consulta" referencedColumnNames="id"
                constraintName="fk_consulta_servico_consulta"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="consulta_servico" baseColumnNames="produto_id"
                referencedTableName="produto" referencedColumnNames="id"
                constraintName="fk_consulta_servico_produto"/>

        <createIndex tableName="consulta_servico" indexName="idx_consulta_servico_consulta">
            <column name="consulta_id"/>
        </createIndex>

        <!-- ── CONSULTA_PRODUTO ──────────────────────────────────────────── -->
        <createTable tableName="consulta_produto">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="consulta_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="produto_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="emitente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="quantidade" type="NUMERIC(10,3)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="preco_unitario" type="NUMERIC(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="consulta_produto" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_consulta_produto_cliente"/>

        <addForeignKeyConstraint
                baseTableName="consulta_produto" baseColumnNames="consulta_id"
                referencedTableName="consulta" referencedColumnNames="id"
                constraintName="fk_consulta_produto_consulta"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="consulta_produto" baseColumnNames="produto_id"
                referencedTableName="produto" referencedColumnNames="id"
                constraintName="fk_consulta_produto_produto"/>

        <addForeignKeyConstraint
                baseTableName="consulta_produto" baseColumnNames="emitente_id"
                referencedTableName="emitente" referencedColumnNames="id"
                constraintName="fk_consulta_produto_emitente"/>

        <createIndex tableName="consulta_produto" indexName="idx_consulta_produto_consulta">
            <column name="consulta_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
