<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="058-create-configuracao-pendencias" author="eduardo">

        <createTable tableName="configuracao_pendencias">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="dias_antes" type="INTEGER"/>

            <column name="notificar_clientes_vencimento" type="VARCHAR(3)"/>

            <column name="mensagem_aviso" type="TEXT"/>

            <column name="created_at" type="TIMESTAMP"/>

            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="configuracao_pendencias" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_configuracao_pendencias_cliente"
                onDelete="RESTRICT"/>

        <createIndex tableName="configuracao_pendencias" indexName="idx_configuracao_pendencias_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
