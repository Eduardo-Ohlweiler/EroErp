<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="053-create-gym" author="eduardo">

        <!-- ── EXERCICIO ──────────────────────────────────────────────────── -->
        <createTable tableName="exercicio">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="nome" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="descricao" type="TEXT"/>

            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="exercicio" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_exercicio_cliente"
                onDelete="RESTRICT"/>

        <createIndex tableName="exercicio" indexName="idx_exercicio_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

        <!-- ── PLANO_TREINO ───────────────────────────────────────────────── -->
        <createTable tableName="plano_treino">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="emitente_id" type="BIGINT"/>

            <column name="nome" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="data_inicio" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="data_fim" type="DATE"/>

            <column name="observacao" type="TEXT"/>

            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="plano_treino" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_plano_treino_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="plano_treino" baseColumnNames="pessoa_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_plano_treino_pessoa"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="plano_treino" baseColumnNames="emitente_id"
                referencedTableName="emitente" referencedColumnNames="id"
                constraintName="fk_plano_treino_emitente"
                onDelete="SET NULL"/>

        <createIndex tableName="plano_treino" indexName="idx_plano_treino_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

        <createIndex tableName="plano_treino" indexName="idx_plano_treino_pessoa_id">
            <column name="pessoa_id"/>
        </createIndex>

        <!-- ── ITEM_PLANO_TREINO ───────────────────────────────────────────── -->
        <createTable tableName="item_plano_treino">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="plano_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="exercicio_id" type="BIGINT"/>

            <!-- SEGUNDA | TERCA | QUARTA | QUINTA | SEXTA | SABADO | DOMINGO -->
            <column name="dia_semana" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <!-- Ordem de exibição dentro do dia -->
            <column name="ordem" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <!-- Número de séries -->
            <column name="series" type="INTEGER"/>

            <!-- Número de repetições por série -->
            <column name="repeticoes" type="VARCHAR(50)"/>

            <!-- NORMAL | DROPSET | DROPSET_INVERTIDO -->
            <column name="tipo_execucao" type="VARCHAR(30)"/>

            <!-- Tempo de pausa em segundos -->
            <column name="pausa_segundos" type="INTEGER"/>

            <column name="observacao" type="TEXT"/>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="item_plano_treino" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_item_plano_treino_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="item_plano_treino" baseColumnNames="plano_id"
                referencedTableName="plano_treino" referencedColumnNames="id"
                constraintName="fk_item_plano_treino_plano"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="item_plano_treino" baseColumnNames="exercicio_id"
                referencedTableName="exercicio" referencedColumnNames="id"
                constraintName="fk_item_plano_treino_exercicio"
                onDelete="SET NULL"/>

        <createIndex tableName="item_plano_treino" indexName="idx_item_plano_treino_plano_id">
            <column name="plano_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
