<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="015-create-enum-tipo-emitente" author="eduardo">
        <sql>
            CREATE TYPE tipo_emitente AS ENUM ('MATRIZ', 'FILIAL');
        </sql>
        <rollback>
            DROP TYPE tipo_emitente;
        </rollback>
    </changeSet>

    <changeSet id="015-create-table-emitente" author="eduardo">

        <createTable tableName="emitente">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_emitente_cliente"
                             references="cliente(id)"/>
            </column>

            <!-- Uma pessoa só pode ser emitente uma única vez -->
            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uq_emitente_pessoa"
                             foreignKeyName="fk_emitente_pessoa"
                             references="pessoa(id)"/>
            </column>

            <column name="tipo" type="tipo_emitente">
                <constraints nullable="false"/>
            </column>

            <!-- Preenchido apenas quando tipo = FILIAL -->
            <column name="pessoa_matriz_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_emitente_pessoa_matriz"
                             references="pessoa(id)"/>
            </column>

            <column name="cor" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="bloqueado" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <createIndex tableName="emitente" indexName="idx_emitente_cliente">
            <column name="cliente_id"/>
        </createIndex>

        <createIndex tableName="emitente" indexName="idx_emitente_pessoa">
            <column name="pessoa_id"/>
        </createIndex>

        <rollback>
            DROP TABLE emitente;
        </rollback>

    </changeSet>

</databaseChangeLog>