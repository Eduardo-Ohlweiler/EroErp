<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="086-create-tipo-pedido" author="eduardo">

        <createTable tableName="tipo_pedido">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="nome" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- NENHUM | ENTRADA | SAIDA -->
            <column name="movimenta_estoque" type="VARCHAR(10)" defaultValue="NENHUM">
                <constraints nullable="false"/>
            </column>

            <!-- NENHUM | CONTAS_RECEBER | CONTAS_PAGAR -->
            <column name="gera_financeiro" type="VARCHAR(15)" defaultValue="NENHUM">
                <constraints nullable="false"/>
            </column>

            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="tipo_pedido" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_tipo_pedido_cliente"/>

        <createIndex tableName="tipo_pedido" indexName="idx_tipo_pedido_cliente">
            <column name="cliente_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
