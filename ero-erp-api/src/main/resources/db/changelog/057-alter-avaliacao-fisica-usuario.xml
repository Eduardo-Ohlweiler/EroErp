<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="057-alter-avaliacao-fisica-usuario" author="eduardo">

        <dropForeignKeyConstraint
                baseTableName="avaliacao_fisica"
                constraintName="fk_avaliacao_fisica_emitente"/>

        <dropColumn tableName="avaliacao_fisica" columnName="emitente_id"/>

        <addColumn tableName="avaliacao_fisica">
            <column name="usuario_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="avaliacao_fisica" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_avaliacao_fisica_usuario"
                onDelete="SET NULL"/>

    </changeSet>

</databaseChangeLog>
