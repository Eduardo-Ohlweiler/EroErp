<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="103-create-crm-fluxo-kanban-coluna" author="eduardo">

        <createTable tableName="crm_fluxo_kanban_coluna">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="andamento_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ordem" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="crm_fluxo_kanban_coluna" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_crm_fluxo_kanban_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="crm_fluxo_kanban_coluna" baseColumnNames="andamento_id"
                referencedTableName="crm_andamento" referencedColumnNames="id"
                constraintName="fk_crm_fluxo_kanban_andamento"
                onDelete="RESTRICT"/>

        <addUniqueConstraint
                tableName="crm_fluxo_kanban_coluna"
                columnNames="cliente_id, andamento_id"
                constraintName="uk_crm_fluxo_kanban_cliente_andamento"/>

        <createIndex tableName="crm_fluxo_kanban_coluna" indexName="idx_crm_fluxo_kanban_cliente">
            <column name="cliente_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
