<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="022-create-configuracao-mensagem" author="system">
        <createTable tableName="configuracao_mensagem">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="cabecalho_agendamento" type="TEXT"/>
            <column name="rodape_agendamento"    type="TEXT"/>
            <column name="cabecalho_lembrete"    type="TEXT"/>
            <column name="rodape_lembrete"       type="TEXT"/>
            <column name="cabecalho_cancelamento" type="TEXT"/>
            <column name="rodape_cancelamento"   type="TEXT"/>
            <column name="cabecalho_conclusao"   type="TEXT"/>
            <column name="rodape_conclusao"      type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="configuracao_mensagem"
            baseColumnNames="cliente_id"
            constraintName="fk_config_mensagem_cliente"
            referencedTableName="cliente"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="configuracao_mensagem"
            baseColumnNames="usuario_id"
            constraintName="fk_config_mensagem_usuario"
            referencedTableName="usuario"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createIndex tableName="configuracao_mensagem" indexName="idx_config_mensagem_cliente_id">
            <column name="cliente_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
