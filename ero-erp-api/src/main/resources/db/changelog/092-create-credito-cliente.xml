<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Razão de crédito do cliente (haver): ENTRADA por devolução, USO em faturamento -->
    <changeSet id="092-create-credito-cliente" author="eduardo">

        <createTable tableName="credito_cliente">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- ENTRADA | USO -->
            <column name="tipo" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="valor" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>

            <column name="origem" type="VARCHAR(255)"/>

            <!-- referências soft (sem FK), como pedido.conta_id -->
            <column name="pedido_id" type="BIGINT"/>
            <column name="conta_receber_id" type="BIGINT"/>

            <column name="data" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="credito_cliente" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_credito_cliente_cliente"/>

        <addForeignKeyConstraint
                baseTableName="credito_cliente" baseColumnNames="pessoa_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_credito_cliente_pessoa"/>

        <addForeignKeyConstraint
                baseTableName="credito_cliente" baseColumnNames="created_by"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_credito_cliente_created_by"/>

        <createIndex tableName="credito_cliente" indexName="idx_credito_cliente_pessoa">
            <column name="cliente_id"/>
            <column name="pessoa_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
