<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="081-create-otorrino-exame-laudo" author="eduardo">

        <createTable tableName="exame_laudo">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="usuario_id" type="BIGINT"/>

            <!-- vínculo opcional com a consulta (padrão fichaAnamnese) -->
            <column name="consulta_id" type="BIGINT"/>

            <column name="data_exame" type="DATE">
                <constraints nullable="false"/>
            </column>

            <!-- NASOFIBROSCOPIA | LARINGOSCOPIA | VIDEOLARINGOSCOPIA | RINOSCOPIA | OUTRO -->
            <column name="tipo_exame" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="laudo" type="TEXT"/>
            <column name="conclusao" type="TEXT"/>
            <column name="cid" type="VARCHAR(10)"/>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="exame_laudo" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_exame_laudo_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="exame_laudo" baseColumnNames="pessoa_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_exame_laudo_pessoa"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="exame_laudo" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_exame_laudo_usuario"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="exame_laudo" baseColumnNames="consulta_id"
                referencedTableName="consulta" referencedColumnNames="id"
                constraintName="fk_exame_laudo_consulta"
                onDelete="SET NULL"/>

        <createIndex tableName="exame_laudo" indexName="idx_exame_laudo_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

        <createIndex tableName="exame_laudo" indexName="idx_exame_laudo_pessoa_id">
            <column name="pessoa_id"/>
        </createIndex>

        <createIndex tableName="exame_laudo" indexName="idx_exame_laudo_consulta_id">
            <column name="consulta_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
