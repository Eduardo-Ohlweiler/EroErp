<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="095-add-pacote-consulta" author="eduardo">
        <addColumn tableName="consulta">
            <column name="pacote_id" type="BIGINT"/>
            <column name="sessao" type="INT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="consulta" baseColumnNames="pacote_id"
                referencedTableName="pacote_contratado" referencedColumnNames="id"
                constraintName="fk_consulta_pacote"/>

        <createIndex tableName="consulta" indexName="idx_consulta_pacote">
            <column name="pacote_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
