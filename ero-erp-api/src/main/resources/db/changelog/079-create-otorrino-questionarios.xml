<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="079-create-otorrino-questionarios" author="eduardo">

        <!-- ── QUESTIONARIO (catálogo) ─────────────────────────────────────── -->
        <createTable tableName="questionario">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <!-- nullable: NULL = questionário global do sistema -->
            <column name="cliente_id" type="BIGINT"/>
            <!-- THI | DHI | SNOT22 | EPWORTH | NOSE -->
            <column name="codigo" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="TEXT"/>
            <column name="instrucao" type="TEXT"/>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="questionario" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_questionario_cliente"
                onDelete="RESTRICT"/>

        <createIndex tableName="questionario" indexName="idx_questionario_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

        <!-- ── QUESTIONARIO_OPCAO (escala de resposta compartilhada) ────────── -->
        <createTable tableName="questionario_opcao">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="questionario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ordem" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="rotulo" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="valor" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="questionario_opcao" baseColumnNames="questionario_id"
                referencedTableName="questionario" referencedColumnNames="id"
                constraintName="fk_questionario_opcao_questionario"
                onDelete="CASCADE"/>

        <createIndex tableName="questionario_opcao" indexName="idx_questionario_opcao_questionario_id">
            <column name="questionario_id"/>
        </createIndex>

        <!-- ── QUESTIONARIO_ITEM ────────────────────────────────────────────── -->
        <createTable tableName="questionario_item">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="questionario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ordem" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="enunciado" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <!-- domínio opcional: ex. F/E/C (THI) ou P/E/F (DHI) -->
            <column name="dominio" type="VARCHAR(20)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="questionario_item" baseColumnNames="questionario_id"
                referencedTableName="questionario" referencedColumnNames="id"
                constraintName="fk_questionario_item_questionario"
                onDelete="CASCADE"/>

        <createIndex tableName="questionario_item" indexName="idx_questionario_item_questionario_id">
            <column name="questionario_id"/>
        </createIndex>

        <!-- ── QUESTIONARIO_APLICADO (instância respondida) ─────────────────── -->
        <createTable tableName="questionario_aplicado">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT"/>
            <column name="consulta_id" type="BIGINT"/>
            <column name="questionario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="data_aplicacao" type="DATE">
                <constraints nullable="false"/>
            </column>
            <!-- snapshot calculado no backend -->
            <column name="score_total" type="INTEGER"/>
            <column name="classificacao" type="VARCHAR(100)"/>
            <column name="interpretacao" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="questionario_aplicado" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_questionario_aplicado_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="questionario_aplicado" baseColumnNames="pessoa_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_questionario_aplicado_pessoa"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="questionario_aplicado" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_questionario_aplicado_usuario"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="questionario_aplicado" baseColumnNames="consulta_id"
                referencedTableName="consulta" referencedColumnNames="id"
                constraintName="fk_questionario_aplicado_consulta"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="questionario_aplicado" baseColumnNames="questionario_id"
                referencedTableName="questionario" referencedColumnNames="id"
                constraintName="fk_questionario_aplicado_questionario"
                onDelete="RESTRICT"/>

        <createIndex tableName="questionario_aplicado" indexName="idx_questionario_aplicado_cliente_id">
            <column name="cliente_id"/>
        </createIndex>
        <createIndex tableName="questionario_aplicado" indexName="idx_questionario_aplicado_pessoa_id">
            <column name="pessoa_id"/>
        </createIndex>
        <createIndex tableName="questionario_aplicado" indexName="idx_questionario_aplicado_consulta_id">
            <column name="consulta_id"/>
        </createIndex>

        <!-- ── QUESTIONARIO_RESPOSTA ────────────────────────────────────────── -->
        <createTable tableName="questionario_resposta">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="aplicado_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="valor" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="questionario_resposta" baseColumnNames="aplicado_id"
                referencedTableName="questionario_aplicado" referencedColumnNames="id"
                constraintName="fk_questionario_resposta_aplicado"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="questionario_resposta" baseColumnNames="item_id"
                referencedTableName="questionario_item" referencedColumnNames="id"
                constraintName="fk_questionario_resposta_item"
                onDelete="RESTRICT"/>

        <createIndex tableName="questionario_resposta" indexName="idx_questionario_resposta_aplicado_id">
            <column name="aplicado_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
