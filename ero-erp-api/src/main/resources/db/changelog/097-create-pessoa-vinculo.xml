<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="097-create-pessoa-vinculo" author="eduardo">

        <createTable tableName="pessoa_vinculo">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_origem_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_destino_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- RESPONSAVEL | DEPENDENTE | CONJUGE | FAMILIAR -->
            <column name="tipo" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="observacao" type="VARCHAR(255)"/>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="pessoa_vinculo" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_pessoa_vinculo_cliente"/>

        <addForeignKeyConstraint
                baseTableName="pessoa_vinculo" baseColumnNames="pessoa_origem_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_pessoa_vinculo_origem"/>

        <addForeignKeyConstraint
                baseTableName="pessoa_vinculo" baseColumnNames="pessoa_destino_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_pessoa_vinculo_destino"/>

        <addUniqueConstraint
                tableName="pessoa_vinculo"
                columnNames="cliente_id, pessoa_origem_id, pessoa_destino_id"
                constraintName="uq_pessoa_vinculo_par"/>

        <createIndex tableName="pessoa_vinculo" indexName="idx_pessoa_vinculo_cliente">
            <column name="cliente_id"/>
        </createIndex>

        <createIndex tableName="pessoa_vinculo" indexName="idx_pessoa_vinculo_origem">
            <column name="pessoa_origem_id"/>
        </createIndex>

        <createIndex tableName="pessoa_vinculo" indexName="idx_pessoa_vinculo_destino">
            <column name="pessoa_destino_id"/>
        </createIndex>

        <sql>
            ALTER TABLE pessoa_vinculo
                ADD CONSTRAINT ck_pessoa_vinculo_tipo
                    CHECK (tipo IN ('RESPONSAVEL', 'DEPENDENTE', 'CONJUGE', 'FAMILIAR'));
        </sql>

        <sql>
            ALTER TABLE pessoa_vinculo
                ADD CONSTRAINT ck_pessoa_vinculo_pessoas_distintas
                    CHECK (pessoa_origem_id &lt;&gt; pessoa_destino_id);
        </sql>

    </changeSet>

</databaseChangeLog>
