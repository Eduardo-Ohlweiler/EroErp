<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="102-create-crm-lembrete-pendencia" author="eduardo">

        <createTable tableName="crm_lembrete_pendencia">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="configuracao_crm_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tempo_horas" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="mensagem" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="ordem" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="crm_lembrete_pendencia" baseColumnNames="configuracao_crm_id"
                referencedTableName="configuracao_crm" referencedColumnNames="id"
                constraintName="fk_crm_lembrete_pendencia_config"
                onDelete="CASCADE"/>

        <createIndex tableName="crm_lembrete_pendencia" indexName="idx_crm_lembrete_pendencia_config">
            <column name="configuracao_crm_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
