<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="098-add-anexos-pacote" author="eduardo">
        <addColumn tableName="pacote_contratado">
            <column name="documento_id" type="BIGINT"/>
            <column name="ficha_anamnese_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="pacote_contratado" baseColumnNames="documento_id"
                referencedTableName="documento" referencedColumnNames="id"
                constraintName="fk_pacote_documento"/>

        <addForeignKeyConstraint
                baseTableName="pacote_contratado" baseColumnNames="ficha_anamnese_id"
                referencedTableName="ficha_anamnese" referencedColumnNames="id"
                constraintName="fk_pacote_ficha_anamnese"/>

        <createIndex tableName="pacote_contratado" indexName="idx_pacote_documento">
            <column name="documento_id"/>
        </createIndex>

        <createIndex tableName="pacote_contratado" indexName="idx_pacote_ficha_anamnese">
            <column name="ficha_anamnese_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
