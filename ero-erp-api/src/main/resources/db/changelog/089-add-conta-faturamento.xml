<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Vínculo (soft) da conta financeira gerada ao faturar -->
    <changeSet id="089-add-conta-faturamento" author="eduardo">

        <addColumn tableName="consulta">
            <column name="conta_receber_id" type="BIGINT"/>
        </addColumn>

        <addColumn tableName="pedido">
            <column name="conta_id" type="BIGINT"/>
        </addColumn>

    </changeSet>

</databaseChangeLog>
