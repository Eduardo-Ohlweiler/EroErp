<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Rastreio de devolução incremental por item do pedido -->
    <changeSet id="091-add-quantidade-devolvida-pedido-produto" author="eduardo">

        <addColumn tableName="pedido_produto">
            <column name="quantidade_devolvida" type="NUMERIC(10,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

    </changeSet>

</databaseChangeLog>
