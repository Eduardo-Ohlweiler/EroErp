<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="024-create-tipo-produto" author="eduardo">
        <createTable tableName="tipo_produto">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="nome" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="024-create-unidade-medida" author="eduardo">
        <createTable tableName="unidade_medida">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="sigla" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="024-create-ncm" author="eduardo">
        <createTable tableName="ncm">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="codigo" type="VARCHAR(8)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="descricao" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="024-create-origem-produto" author="eduardo">
        <createTable tableName="origem_produto">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="codigo" type="VARCHAR(1)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="descricao" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="024-create-cest" author="eduardo">
        <createTable tableName="cest">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="codigo" type="VARCHAR(9)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="descricao" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="ncm_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_cest_ncm" references="ncm(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="024-create-grupo" author="eduardo">
        <createTable tableName="grupo">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_grupo_cliente" references="cliente(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="grupo" indexName="idx_grupo_cliente_id">
            <column name="cliente_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="024-create-subgrupo" author="eduardo">
        <createTable tableName="subgrupo">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_subgrupo_cliente" references="cliente(id)"/>
            </column>
            <column name="grupo_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_subgrupo_grupo" references="grupo(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="subgrupo" indexName="idx_subgrupo_cliente_id">
            <column name="cliente_id"/>
        </createIndex>
        <createIndex tableName="subgrupo" indexName="idx_subgrupo_grupo_id">
            <column name="grupo_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="024-create-categoria" author="eduardo">
        <createTable tableName="categoria">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_categoria_cliente" references="cliente(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="categoria" indexName="idx_categoria_cliente_id">
            <column name="cliente_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="024-create-marca" author="eduardo">
        <createTable tableName="marca">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_marca_cliente" references="cliente(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="marca" indexName="idx_marca_cliente_id">
            <column name="cliente_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
