<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="045-create-lancamento-financeiro" author="eduardo">

        <createTable tableName="lancamento_financeiro">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="conta_financeira_id" type="BIGINT"/>
            <column name="tipo" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="valor" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(255)"/>
            <column name="data" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="lancamento_financeiro" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_lancamento_financeiro_cliente"/>
        <addForeignKeyConstraint
                baseTableName="lancamento_financeiro" baseColumnNames="conta_financeira_id"
                referencedTableName="conta_financeira" referencedColumnNames="id"
                constraintName="fk_lancamento_financeiro_conta_financeira"/>

        <createIndex tableName="lancamento_financeiro" indexName="idx_lancamento_financeiro_cliente_id">
            <column name="cliente_id"/>
        </createIndex>
        <createIndex tableName="lancamento_financeiro" indexName="idx_lancamento_financeiro_data">
            <column name="data"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
