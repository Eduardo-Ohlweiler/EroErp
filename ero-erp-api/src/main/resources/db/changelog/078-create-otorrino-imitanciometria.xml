<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="078-create-otorrino-imitanciometria" author="eduardo">

        <createTable tableName="imitanciometria">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="usuario_id" type="BIGINT"/>

            <!-- vínculo opcional com a consulta (padrão fichaAnamnese) -->
            <column name="consulta_id" type="BIGINT"/>

            <column name="data_exame" type="DATE">
                <constraints nullable="false"/>
            </column>

            <!-- Curva timpanométrica (Jerger): A | As | Ad | B | C -->
            <column name="curva_od" type="VARCHAR(2)"/>
            <column name="curva_oe" type="VARCHAR(2)"/>

            <!-- Pico de pressão (daPa) -->
            <column name="pico_pressao_od_dapa" type="INTEGER"/>
            <column name="pico_pressao_oe_dapa" type="INTEGER"/>

            <!-- Complacência / admitância de pico (ml) -->
            <column name="complacencia_od_ml" type="DECIMAL(10,2)"/>
            <column name="complacencia_oe_ml" type="DECIMAL(10,2)"/>

            <!-- Volume do conduto auditivo externo (ml) -->
            <column name="volume_canal_od_ml" type="DECIMAL(10,2)"/>
            <column name="volume_canal_oe_ml" type="DECIMAL(10,2)"/>

            <!-- Reflexo estapédico: PRESENTE | AUSENTE | NAO_TESTADO -->
            <column name="reflexo_ipsi_od"   type="VARCHAR(15)"/>
            <column name="reflexo_contra_od" type="VARCHAR(15)"/>
            <column name="reflexo_ipsi_oe"   type="VARCHAR(15)"/>
            <column name="reflexo_contra_oe" type="VARCHAR(15)"/>

            <column name="observacao" type="TEXT"/>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="imitanciometria" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_imitanciometria_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="imitanciometria" baseColumnNames="pessoa_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_imitanciometria_pessoa"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="imitanciometria" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_imitanciometria_usuario"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="imitanciometria" baseColumnNames="consulta_id"
                referencedTableName="consulta" referencedColumnNames="id"
                constraintName="fk_imitanciometria_consulta"
                onDelete="SET NULL"/>

        <createIndex tableName="imitanciometria" indexName="idx_imitanciometria_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

        <createIndex tableName="imitanciometria" indexName="idx_imitanciometria_pessoa_id">
            <column name="pessoa_id"/>
        </createIndex>

        <createIndex tableName="imitanciometria" indexName="idx_imitanciometria_consulta_id">
            <column name="consulta_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
