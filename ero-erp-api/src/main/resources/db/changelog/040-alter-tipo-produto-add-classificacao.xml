<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="040-alter-tipo-produto-add-classificacao" author="eduardo">
        <addColumn tableName="tipo_produto">
            <column name="classificacao" type="VARCHAR(10)" defaultValue="PRODUTO">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="040-update-tipo-produto-classificacao-servico" author="eduardo">
        <update tableName="tipo_produto">
            <column name="classificacao" value="SERVICO"/>
            <where>nome = 'Serviço'</where>
        </update>
    </changeSet>

</databaseChangeLog>
