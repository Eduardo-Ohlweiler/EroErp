<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="054-alter-plano-treino-personal" author="eduardo">

        <dropForeignKeyConstraint
                baseTableName="plano_treino"
                constraintName="fk_plano_treino_emitente"/>

        <dropColumn tableName="plano_treino" columnName="emitente_id"/>

        <addColumn tableName="plano_treino">
            <column name="usuario_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="plano_treino" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_plano_treino_usuario"
                onDelete="SET NULL"/>

    </changeSet>

</databaseChangeLog>
