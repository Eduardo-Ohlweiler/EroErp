<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="077-create-otorrino-audiometria" author="eduardo">

        <!-- ── AUDIOMETRIA (mãe) ──────────────────────────────────────────── -->
        <createTable tableName="audiometria">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="pessoa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="usuario_id" type="BIGINT"/>

            <!-- vínculo opcional com a consulta (padrão fichaAnamnese) -->
            <column name="consulta_id" type="BIGINT"/>

            <column name="data_exame" type="DATE">
                <constraints nullable="false"/>
            </column>

            <!-- Logoaudiometria (por orelha) -->
            <column name="srt_od_db" type="INTEGER"/>
            <column name="srt_oe_db" type="INTEGER"/>
            <column name="irf_od_perc" type="DECIMAL(5,2)"/>
            <column name="irf_oe_perc" type="DECIMAL(5,2)"/>

            <!-- Resultados calculados (snapshot) -->
            <column name="media_od" type="DECIMAL(5,2)"/>
            <column name="media_oe" type="DECIMAL(5,2)"/>
            <column name="grau_od" type="VARCHAR(30)"/>
            <column name="grau_oe" type="VARCHAR(30)"/>
            <column name="tipo_perda_od" type="VARCHAR(30)"/>
            <column name="tipo_perda_oe" type="VARCHAR(30)"/>
            <!-- norma usada na classificação: OMS | BIAP -->
            <column name="norma" type="VARCHAR(10)"/>

            <column name="observacao" type="TEXT"/>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="audiometria" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_audiometria_cliente"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="audiometria" baseColumnNames="pessoa_id"
                referencedTableName="pessoa" referencedColumnNames="id"
                constraintName="fk_audiometria_pessoa"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="audiometria" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_audiometria_usuario"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="audiometria" baseColumnNames="consulta_id"
                referencedTableName="consulta" referencedColumnNames="id"
                constraintName="fk_audiometria_consulta"
                onDelete="SET NULL"/>

        <createIndex tableName="audiometria" indexName="idx_audiometria_cliente_id">
            <column name="cliente_id"/>
        </createIndex>

        <createIndex tableName="audiometria" indexName="idx_audiometria_pessoa_id">
            <column name="pessoa_id"/>
        </createIndex>

        <createIndex tableName="audiometria" indexName="idx_audiometria_consulta_id">
            <column name="consulta_id"/>
        </createIndex>

        <!-- ── AUDIOMETRIA_LIMIAR (filha — 1 linha por ponto plotado) ─────── -->
        <createTable tableName="audiometria_limiar">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="audiometria_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- OD | OE -->
            <column name="orelha" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>

            <!-- AEREA | OSSEA -->
            <column name="via" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <!-- 250, 500, 1000, 2000, 3000, 4000, 6000, 8000 (Hz) -->
            <column name="frequencia" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <!-- nullable: ponto não testado fica sem linha; limiar em dB (-10 a 120) -->
            <column name="limiar_db" type="INTEGER"/>

            <column name="mascarado" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <!-- testado, porém sem resposta (seta para baixo no audiograma) -->
            <column name="sem_resposta" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="audiometria_limiar" baseColumnNames="audiometria_id"
                referencedTableName="audiometria" referencedColumnNames="id"
                constraintName="fk_audiometria_limiar_audiometria"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="audiometria_limiar"
                columnNames="audiometria_id, orelha, via, frequencia"
                constraintName="uq_audiometria_limiar_ponto"/>

        <createIndex tableName="audiometria_limiar" indexName="idx_audiometria_limiar_audiometria_id">
            <column name="audiometria_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
