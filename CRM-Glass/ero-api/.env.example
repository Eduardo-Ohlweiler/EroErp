# Copie para .env (NÃO versionado) e preencha. Em produção use variáveis de ambiente
# do container, nunca um arquivo dentro da imagem.

# Perfil: passe na linha de comando (-Dspring-boot.run.profiles=dev) ou na variável de ambiente
# SPRING_PROFILES_ACTIVE do sistema; aqui dentro ele NÃO tem efeito.

# --- Segredos (gere valores novos para cada ambiente/contratante) ---
# 32+ bytes em base64. Gerar:  openssl rand -base64 48
APP_JWT_SEGREDO=
# Exatamente 32 bytes em base64. Gerar:  openssl rand -base64 32
# ATENÇÃO: trocar esta chave torna ilegíveis os campos cifrados já gravados.
APP_CRIPTO_CHAVE=

# --- Superadmin criado na primeira subida (senha com 12+ caracteres) ---
SUPERADMIN_EMAIL=
SUPERADMIN_SENHA=
SUPERADMIN_NOME=Superadmin

# --- Front que pode chamar a API (separe por vírgula) ---
APP_CORS_ORIGENS=http://localhost:5173

# --- Só produção ---
DB_URL=jdbc:postgresql://host:5432/ero_api
DB_USUARIO=
DB_SENHA=
# native = confia no X-Forwarded-* do proxy reverso; none = sem proxy
APP_PROXY_HEADERS=native
