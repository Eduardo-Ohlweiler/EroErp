# Copie para .env (NÃO versionado) e preencha. Em produção use variáveis de ambiente
# do container, nunca um arquivo dentro da imagem.

# Perfil: passe na linha de comando (-Dspring-boot.run.profiles=dev) ou na variável de ambiente
# SPRING_PROFILES_ACTIVE do sistema; aqui dentro ele NÃO tem efeito.

# --- Segredos (gere valores novos para cada ambiente/contratante) ---
# 32+ bytes em base64. Gerar:  openssl rand -base64 48
APP_JWT_SEGREDO=
# Exatamente 32 bytes em base64. Gerar:  openssl rand -base64 32
# ATENÇÃO: trocar esta chave torna ilegíveis os campos cifrados já gravados.
APP_CRIPTO_CHAVE=

# --- Superadmin criado na primeira subida (senha com 12+ caracteres) ---
SUPERADMIN_EMAIL=
SUPERADMIN_SENHA=
SUPERADMIN_NOME=Superadmin

# --- E-mail: o código de 6 dígitos do login sai por aqui (TODOS os usuários recebem) ---
# Sem isto preenchido a API sobe com um aviso e o login responde 503.
#
# Gmail com senha de app (padrão: smtp.gmail.com, porta 587, STARTTLS obrigatório):
#   1. Conta Google -> Segurança -> ligue a "Verificação em duas etapas" (sem ela não aparece a opção seguinte).
#   2. Conta Google -> Segurança -> Verificação em duas etapas -> "Senhas de app"
#      (ou direto em https://myaccount.google.com/apppasswords).
#   3. Crie uma senha de app com o nome "CRM Glass" e copie os 16 caracteres (sem espaços) para MAIL_SENHA_APP.
#   4. MAIL_USUARIO é o endereço Gmail inteiro. É ele que aparece como remetente.
# A senha de app é um segredo: nunca vai para o git nem para o log. Se vazar, revogue na mesma tela.
MAIL_USUARIO=
MAIL_SENHA_APP=
MAIL_REMETENTE_NOME=CRM Glass

# Opcional: outro servidor SMTP. Exemplo de Mailpit local (sem TLS e sem login), para testes:
#   MAIL_HOST=localhost
#   MAIL_PORTA=1025
#   MAIL_SMTP_AUTH=false
#   MAIL_STARTTLS=false
#   MAIL_REMETENTE=crm@teste.local
# Com login (MAIL_SMTP_AUTH=true) nunca desligue o STARTTLS fora de dev: a senha iria em texto claro
# (a API sobe, mas registra ERRO no log).
# MAIL_REMETENTE é o endereço do "De:" (padrão: o próprio MAIL_USUARIO; obrigatório quando não há MAIL_USUARIO).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORTA=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_REMETENTE=

# --- Front que pode chamar a API (separe por vírgula) ---
APP_CORS_ORIGENS=http://localhost:5173

# --- Códigos de login NOVOS por usuário por hora (padrão 10; reenvios não contam) ---
# Automação local que entra muitas vezes com o mesmo usuário pode precisar de mais
# (no máximo 1000; acima de 10 fora do perfil dev a subida registra um ERRO no log).
# APP_CODIGO_MAX_EMISSOES_POR_HORA=10

# --- Só produção ---
DB_URL=jdbc:postgresql://host:5432/ero_api
DB_USUARIO=
DB_SENHA=
# native = confia no X-Forwarded-* do proxy reverso; none = sem proxy
APP_PROXY_HEADERS=native
