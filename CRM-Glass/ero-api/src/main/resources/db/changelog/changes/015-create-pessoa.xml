<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Pessoa (módulo pessoa): física e jurídica na mesma tabela, com um ou mais tipos
        de cadastro (pessoa_tipo_cadastro).

        - cod_pessoa: código por contratante (maior + 1, ver docs/01 "Código do registro").
        - nome é a razão social na PJ; nome_busca = TextoBusca.normalizar(nome + " " +
          fantasia), para a busca sem acento e sem caixa.
        - CPF e RG em claro (decisão do dono, 16/11/2026). CPF e CNPJ únicos no
          contratante (índices parciais: nulo não colide). RG não é único.
        - ck_pessoa_campos_do_tipo: o campo do outro tipo fica sempre nulo (trocar o tipo
          limpa os campos anteriores).
        - uk_pessoa_id_tenant é o alvo das FKs compostas (pessoa_id, tenant_id) das
          filhas e dos vínculos: o banco garante que nada aponta para a pessoa de outro
          contratante.
    -->
    <changeSet id="015-create-pessoa" author="eduardo">
        <createTable tableName="pessoa">
            <column name="id" type="UUID"><constraints primaryKey="true" primaryKeyName="pk_pessoa"/></column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_pessoa_tenant" references="tenant(id)"/>
            </column>
            <column name="cod_pessoa" type="BIGINT"><constraints nullable="false"/></column>
            <column name="tipo_pessoa" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="nome" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="nome_fantasia" type="VARCHAR(255)"/>
            <column name="nome_busca" type="VARCHAR(511)"><constraints nullable="false"/></column>
            <column name="cpf" type="VARCHAR(11)"/>
            <column name="rg" type="VARCHAR(20)"/>
            <column name="data_nascimento" type="DATE"/>
            <column name="sexo" type="VARCHAR(10)"/>
            <column name="cnpj" type="VARCHAR(14)"/>
            <column name="inscricao_estadual" type="VARCHAR(12)"/>
            <column name="inscricao_municipal" type="VARCHAR(12)"/>
            <column name="observacao" type="VARCHAR(500)"/>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="pessoa" indexName="uk_pessoa_tenant_cod_pessoa" unique="true">
            <column name="tenant_id"/>
            <column name="cod_pessoa"/>
        </createIndex>
        <createIndex tableName="pessoa" indexName="uk_pessoa_id_tenant" unique="true">
            <column name="id"/>
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="pessoa" indexName="ix_pessoa_tenant_nome">
            <column name="tenant_id"/>
            <column name="nome"/>
        </createIndex>
        <sql>CREATE UNIQUE INDEX uk_pessoa_tenant_cpf ON pessoa (tenant_id, cpf) WHERE cpf IS NOT NULL</sql>
        <sql>CREATE UNIQUE INDEX uk_pessoa_tenant_cnpj ON pessoa (tenant_id, cnpj) WHERE cnpj IS NOT NULL</sql>
        <sql>ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_cod_pessoa CHECK (cod_pessoa &gt; 0)</sql>
        <sql>ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_tipo_pessoa CHECK (tipo_pessoa IN ('FISICA', 'JURIDICA'))</sql>
        <sql>ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_sexo CHECK (sexo IN ('MASCULINO', 'FEMININO'))</sql>
        <sql>ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_cpf CHECK (cpf ~ '^[0-9]{11}$')</sql>
        <sql>ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_cnpj CHECK (cnpj ~ '^[0-9A-Z]{12}[0-9]{2}$')</sql>
        <sql>ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_inscricao_estadual CHECK (inscricao_estadual ~ '^[0-9]{5,12}$')</sql>
        <sql>ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_inscricao_municipal CHECK (inscricao_municipal ~ '^[0-9]{5,12}$')</sql>
        <sql>
            ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_campos_do_tipo CHECK (
                (tipo_pessoa = 'FISICA' AND cnpj IS NULL AND nome_fantasia IS NULL
                    AND inscricao_estadual IS NULL AND inscricao_municipal IS NULL)
                OR (tipo_pessoa = 'JURIDICA' AND cpf IS NULL AND rg IS NULL
                    AND data_nascimento IS NULL AND sexo IS NULL))
        </sql>
    </changeSet>

    <!--
        Tipos de cadastro da pessoa (N:N com tipo_cadastro). Filha como as outras: a
        lista que chega no salvar é o estado completo e substitui a anterior.
    -->
    <changeSet id="015-create-pessoa-tipo-cadastro" author="eduardo">
        <createTable tableName="pessoa_tipo_cadastro">
            <column name="id" type="UUID"><constraints primaryKey="true" primaryKeyName="pk_pessoa_tipo_cadastro"/></column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_pessoa_tipo_cadastro_tenant" references="tenant(id)"/>
            </column>
            <column name="pessoa_id" type="UUID"><constraints nullable="false"/></column>
            <column name="tipo_cadastro_id" type="UUID"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_pessoa_tipo_cadastro_pessoa"
                                 baseTableName="pessoa_tipo_cadastro" baseColumnNames="pessoa_id,tenant_id"
                                 referencedTableName="pessoa" referencedColumnNames="id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_pessoa_tipo_cadastro_tipo"
                                 baseTableName="pessoa_tipo_cadastro" baseColumnNames="tipo_cadastro_id,tenant_id"
                                 referencedTableName="tipo_cadastro" referencedColumnNames="id,tenant_id"/>
        <createIndex tableName="pessoa_tipo_cadastro" indexName="uk_pessoa_tipo_cadastro_par" unique="true">
            <column name="tenant_id"/>
            <column name="pessoa_id"/>
            <column name="tipo_cadastro_id"/>
        </createIndex>
        <createIndex tableName="pessoa_tipo_cadastro" indexName="ix_pessoa_tipo_cadastro_pessoa">
            <column name="pessoa_id"/>
        </createIndex>
        <createIndex tableName="pessoa_tipo_cadastro" indexName="ix_pessoa_tipo_cadastro_tipo">
            <column name="tipo_cadastro_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
