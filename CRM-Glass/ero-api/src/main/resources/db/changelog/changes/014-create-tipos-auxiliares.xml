    <changeSet id="014-create-tipos-auxiliares-tipo-cadastro-semente" author="eduardo">
        <sql>
            INSERT INTO tipo_cadastro (id, tenant_id, cod_tipo_cadastro, nome, nome_busca, chave, ativo, created_at, version)
            SELECT gen_random_uuid(), t.id, v.cod, v.nome, v.busca, v.chave, true, now(), 0
            FROM tenant t CROSS JOIN (VALUES
                (1, 'Cliente', 'cliente', 'CLIENTE'),
                (2, 'Fornecedor', 'fornecedor', 'FORNECEDOR'),
                (3, 'Funcionário', 'funcionario', 'FUNCIONARIO'),
                (4, 'Lead', 'lead', 'LEAD'),
                (5, 'Outros', 'outros', 'OUTROS')
            ) AS v(cod, nome, busca, chave)
            WHERE t.id &lt;&gt; '00000000-0000-0000-0000-000000000000';
        </sql>
    </changeSet>

