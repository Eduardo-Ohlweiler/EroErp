{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Read(**/.env.prod*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(deploy/**/.env*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git merge *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(docker push *)",
      "Bash(docker login *)",
      "Bash(docker context *)",
      "Bash(docker -H *)"
    ]
  }
}
