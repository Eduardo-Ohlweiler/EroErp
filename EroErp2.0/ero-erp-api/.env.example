# ── Banco ────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/ero_erp
DB_USER=postgres
DB_PASSWORD=admin

# ── JWT — mínimo 32 caracteres ───────────────────────────────────────
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-de-no-minimo-32-caracteres

# ── Superadmin criado na primeira subida ─────────────────────────────
# Valores com espaço PRECISAM de aspas — o run-dev.sh faz `source .env`.
SUPERADMIN_NAME="Eduardo Ohlweiler"
SUPERADMIN_EMAIL=ohlweilereduardo@gmail.com
SUPERADMIN_PASSWORD="Admin123@Ero"
SUPERADMIN_TENANT_NOME="EroErp Admin"

# ── CORS — origens do frontend, separadas por vírgula ────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Perfil ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Testes ─────────
TEST_DB_URL=jdbc:postgresql://localhost:5432/ero_erp_test
# Vazias, os testes usam DB_USER e DB_PASSWORD (application-test.yml).
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=admin

# ── Criptografia de colunas (apikey da Evolution) ───────────────────
# 32 bytes em base64: openssl rand -base64 32. Sem ela a API não sobe.
# Trocar a chave torna ilegíveis as apikeys já gravadas: redigite-as.
APP_CRIPTO_CHAVE=

# ── WhatsApp (Evolution) ─────────────────────────────────────────────
# URL pública desta API, para a Evolution avisar a conexão pelo webhook
# (ex.: https://erp.seudominio.com.br ou o endereço de um túnel). Vazia,
# o webhook não é configurado e a tela consulta o status à Evolution.
APP_PUBLIC_URL=
