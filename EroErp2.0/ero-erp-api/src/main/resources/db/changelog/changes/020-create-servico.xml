<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Serviço — o que o tenant presta, sem estoque. Ver docs/10.

        No EroErp antigo serviço era uma linha de `produto` com
        tipo_produto.classificacao = 'SERVICO'. Diferenças, todas de propósito:
        - tabela própria: serviço não tem unidade, saldo nem estoque, e não
          aparece na lista de estoque — porque não está lá;
        - o valor é POR FILIAL (servico_filial), opcional. Vazio é NULL, não 0:
          "não informado" e "grátis" são coisas diferentes;
        - código curto por tenant (tenant_sequencia, chave SERVICO), gerado
          pelo sistema e nunca editado — o antigo tinha um Integer digitado,
          sem unicidade;
        - nome único no tenant;
        - sem delete físico: inativa-se, como a pessoa e a filial;
        - created_by / updated_by, como a pessoa.
    -->
    <changeSet id="020-create-servico" author="eduardo">

        <createTable tableName="servico">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_servico"/>
            </column>

            <column name="tenant_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_servico_tenant"
                             references="tenant(id)"/>
            </column>

            <column name="codigo" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="observacao" type="VARCHAR(2000)"/>

            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="UUID">
                <constraints foreignKeyName="fk_servico_created_by" references="usuario(id)"/>
            </column>
            <column name="updated_by" type="UUID">
                <constraints foreignKeyName="fk_servico_updated_by" references="usuario(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addUniqueConstraint tableName="servico"
                             columnNames="tenant_id, codigo"
                             constraintName="uk_servico_tenant_codigo"/>

        <!-- O service confere antes, com unaccent, e responde com frase; isto
             é a rede para a corrida entre duas gravações. -->
        <sql>
            CREATE UNIQUE INDEX uk_servico_tenant_nome ON servico (tenant_id, lower(nome));
        </sql>

        <sql>
            ALTER TABLE servico ADD CONSTRAINT ck_servico_codigo CHECK (codigo &gt; 0);
        </sql>

        <createIndex tableName="servico" indexName="idx_servico_tenant_id">
            <column name="tenant_id"/>
        </createIndex>

        <!-- ══ Valor por filial ══════════════════════════════════════════ -->

        <createTable tableName="servico_filial">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_servico_filial"/>
            </column>

            <column name="tenant_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_servico_filial_tenant"
                             references="tenant(id)"/>
            </column>

            <!-- A linha não tem vida sem o serviço -->
            <column name="servico_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_servico_filial_servico"
                             references="servico(id)"
                             deleteCascade="true"/>
            </column>

            <column name="filial_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_servico_filial_filial"
                             references="filial(id)"/>
            </column>

            <!-- Opcional. NULL = não informado; 0 = informado como zero -->
            <column name="valor" type="NUMERIC(15,2)"/>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addUniqueConstraint tableName="servico_filial"
                             columnNames="servico_id, filial_id"
                             constraintName="uk_servico_filial_servico_filial"/>

        <sql>
            ALTER TABLE servico_filial ADD CONSTRAINT ck_servico_filial_valor
            CHECK (valor IS NULL OR valor &gt;= 0);
        </sql>

        <createIndex tableName="servico_filial" indexName="idx_servico_filial_filial_id">
            <column name="filial_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="servico_filial"/>
            <dropTable tableName="servico"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
