<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Sexo da pessoa física.

        NULLABLE: pessoa jurídica nunca terá sexo, e o cadastro de pessoa
        física não o exige.
    -->
    <changeSet id="014-add-sexo-pessoa" author="eduardo">

        <addColumn tableName="pessoa">
            <column name="sexo" type="VARCHAR(20)"/>
        </addColumn>

        <sql>
            ALTER TABLE pessoa ADD CONSTRAINT ck_pessoa_sexo
            CHECK (sexo IN ('MASCULINO', 'FEMININO'));
        </sql>

        <rollback>
            <sql>ALTER TABLE pessoa DROP CONSTRAINT ck_pessoa_sexo;</sql>
            <dropColumn tableName="pessoa" columnName="sexo"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
