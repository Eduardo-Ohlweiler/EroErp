<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Auxiliares do produto — grupo, subgrupo (de um grupo), categoria e
        marca. POR TENANT: cada cliente organiza o que vende do seu jeito.
        Ver docs/11.

        Diferenças para o antigo, todas correções:
        - sem delete físico: inativa-se. Lá o DELETE estourava a FK do
          produto e virava 500;
        - nome único sem diferenciar maiúscula (índice em lower(nome)); o
          service confere antes com unaccent e responde com frase, o índice é
          a rede para a corrida — unaccent não é IMMUTABLE e não entra em
          índice;
        - o subgrupo é único DENTRO do grupo: "Diversos" pode existir em
          Bebidas e em Limpeza.
    -->
    <changeSet id="022-create-produto-auxiliares" author="eduardo">

        <createTable tableName="grupo_produto">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_grupo_produto"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_grupo_produto_tenant"
                             references="tenant(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createTable tableName="subgrupo_produto">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_subgrupo_produto"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_subgrupo_produto_tenant"
                             references="tenant(id)"/>
            </column>
            <column name="grupo_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_subgrupo_produto_grupo"
                             references="grupo_produto(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createTable tableName="categoria_produto">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_categoria_produto"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_categoria_produto_tenant"
                             references="tenant(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createTable tableName="marca_produto">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_marca_produto"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_marca_produto_tenant"
                             references="tenant(id)"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <sql>
            CREATE UNIQUE INDEX uk_grupo_produto_tenant_nome ON grupo_produto (tenant_id, lower(nome));
            CREATE UNIQUE INDEX uk_subgrupo_produto_grupo_nome ON subgrupo_produto (grupo_id, lower(nome));
            CREATE UNIQUE INDEX uk_categoria_produto_tenant_nome ON categoria_produto (tenant_id, lower(nome));
            CREATE UNIQUE INDEX uk_marca_produto_tenant_nome ON marca_produto (tenant_id, lower(nome));
        </sql>

        <createIndex tableName="subgrupo_produto" indexName="idx_subgrupo_produto_tenant_id">
            <column name="tenant_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="marca_produto"/>
            <dropTable tableName="categoria_produto"/>
            <dropTable tableName="subgrupo_produto"/>
            <dropTable tableName="grupo_produto"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
